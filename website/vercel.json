    },
    {
      "source": "/admon",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admon/:path*",
      "destination": "/admin/:path*",
      "permanent": false
    },
    {
      "source": "/s/:code([A-Za-z2-9]{7})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|slackbot|whatsapp|telegrambot|discordbot|linkedinbot|applebot|skypeuripreview|pinterestbot|redditbot|googlebot|bingbot).*"
